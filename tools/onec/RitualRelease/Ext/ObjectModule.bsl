// Вызов из внешнего соединения. Одна транзакция на карточку, файл и штрихкод.
Функция ОбработатьЗаявку(ТекстJSON, КодОбразца) Экспорт
    Чтение = Новый ЧтениеJSON;
    Чтение.УстановитьСтроку(ТекстJSON);
    Заявка = ПрочитатьJSON(Чтение);
    Чтение.Закрыть();
    ИД = Новый УникальныйИдентификатор(Заявка.release_id);
    Справочник = Справочники.Номенклатура;
    Образец = Справочник.НайтиПоКоду(КодОбразца);
    Если Образец.Пустая() Или Образец.ЭтоГруппа Или Образец.ПометкаУдаления
        Или Образец.ВидНоменклатуры.Наименование <> "Венки"
        Или СокрЛП(Образец.ЕдиницаИзмерения.Наименование) <> "шт" Тогда
        ВызватьИсключение "Выберите действующий образец венка с единицей хранения шт.";
    КонецЕсли;
    Привязана = ЗначениеЗаполнено(Заявка.onec_id);
    Если Привязана Тогда
        Ссылка = Справочник.ПолучитьСсылку(Новый УникальныйИдентификатор(Заявка.onec_id));
    Иначе
        Ссылка = Справочник.ПолучитьСсылку(ИД);
    КонецЕсли;
    ФайлВыпуска = Справочники.НоменклатураПрисоединенныеФайлы.ПолучитьСсылку(ИД);
    НачатьТранзакцию();
    Попытка
        Блокировка = Новый БлокировкаДанных;
        Блокировка.Добавить("Справочник.Номенклатура").УстановитьЗначение("Ссылка", Ссылка);
        Блокировка.Заблокировать();
        Товар = Ссылка.ПолучитьОбъект();
        Если Товар = Неопределено Тогда
            Если Привязана Тогда
                ВызватьИсключение "Выбранная по UUID карточка отсутствует в этой базе.";
            КонецЕсли;
            Одноименная = Справочник.НайтиПоНаименованию(Заявка.name, Истина, Образец.Родитель);
            Если Не Одноименная.Пустая() Тогда
                ВызватьИсключение "Такая карточка уже есть. Укажите ее UUID в заявке.";
            КонецЕсли;
            Товар = Справочник.СоздатьЭлемент();
            Товар.УстановитьСсылкуНового(Ссылка);
            Товар.ВидНоменклатуры = Образец.ВидНоменклатуры;
            Справочник.ЗаполнитьРеквизитыПоВидуНоменклатуры(Товар);
            ЗаполнитьЗначенияСвойств(Товар, Образец, "Родитель,ЕдиницаИзмерения,Качество,ТипНоменклатуры,ИспользованиеХарактеристик,СтавкаНДС,ГруппаДоступа");
        ИначеЕсли Товар.ЭтоГруппа Или Товар.ПометкаУдаления Или Товар.ВидНоменклатуры <> Образец.ВидНоменклатуры Тогда
            ВызватьИсключение "Выбранная позиция не является действующей карточкой венка.";
        КонецЕсли;
        Если ФайлВыпуска.ПолучитьОбъект() = Неопределено Тогда
            Если Не ЗначениеЗаполнено(Товар.Производитель) Тогда
                Мастерская = Справочники.Производители.НайтиПоНаименованию("Авторская мастерская Берегиня", Истина);
                Если Мастерская.Пустая() Или Мастерская.ПометкаУдаления Тогда
                    ВызватьИсключение "Для выпуска венков укажите в справочнике производителей «Авторская мастерская Берегиня».";
                КонецЕсли;
                Товар.Производитель = Мастерская;
            КонецЕсли;
            Товар.Наименование = Заявка.name;
            Товар.НаименованиеПолное = Заявка.name;
            Если Не ЗначениеЗаполнено(Товар.Артикул) Тогда
                Если Не ЗначениеЗаполнено(Товар.Код) Тогда
                    Товар.УстановитьНовыйКод();
                КонецЕсли;
                Товар.Артикул = "ВН-" + СокрЛП(Товар.Код);
            КонецЕсли;
            Размер = "Размер венка: " + Строка(Заявка.height_cm) + " × " + Строка(Заявка.width_cm) + " см";
            Строки = СтрРазделить(Товар.Описание, Символы.ПС, Ложь);
            Описание = Новый Массив;
            Для Каждого СтрОписание Из Строки Цикл
                Если Не СтрНачинаетсяС(СтрОписание, "Размер венка: ") Тогда
                    Описание.Добавить(СтрОписание);
                КонецЕсли;
            КонецЦикла;
            Описание.Добавить(Размер);
            Товар.Описание = СтрСоединить(Описание, Символы.ПС);
            Если Не Товар.ПроверитьЗаполнение() Тогда
                ВызватьИсключение "В УТ не заполнены обязательные реквизиты номенклатуры.";
            КонецЕсли;
            Товар.Записать();
            Параметры = РаботаСФайлами.ПараметрыДобавленияФайла();
            Параметры.ВладелецФайлов = Ссылка;
            Параметры.ИмяБезРасширения = "Венок-" + Заявка.release_id;
            Параметры.РасширениеБезТочки = Заявка.photo_format;
            Адрес = ПоместитьВоВременноеХранилище(Base64Значение(Заявка.photo_base64), ИД);
            Товар.ФайлКартинки = РаботаСФайлами.ДобавитьФайл(Параметры, Адрес, , , ФайлВыпуска);
            Товар.Записать();
        ИначеЕсли Товар.ФайлКартинки <> ФайлВыпуска Тогда
            ВызватьИсключение "Основное изображение изменилось после обработки этой заявки.";
        КонецЕсли;
        Штрихкод = ШтрихкодИзделия(Ссылка);
        Опт = ЦенаОпт(Ссылка);
        Ответ = Новый Структура("release_id,onec_id,article,barcode,barcode_type",
            Заявка.release_id, Строка(Ссылка.УникальныйИдентификатор()), Товар.Артикул, Штрихкод, "ean13");
        Если Опт > 0 Тогда
            Ответ.Вставить("wholesale_price_rub", Опт);
        КонецЕсли;
        Запись = Новый ЗаписьJSON;
        Запись.УстановитьСтроку();
        ЗаписатьJSON(Запись, Ответ);
        Результат = Запись.Закрыть();
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция ШтрихкодИзделия(Ссылка)
    Запрос = Новый Запрос("ВЫБРАТЬ К.Штрихкод ИЗ РегистрСведений.ШтрихкодыНоменклатуры КАК К
        |ГДЕ К.Номенклатура = &Товар И К.Упаковка = ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
        |И К.Характеристика = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
        |И К.Серия = ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.ПустаяСсылка) УПОРЯДОЧИТЬ ПО К.Штрихкод");
    Запрос.УстановитьПараметр("Товар", Ссылка);
    Выборка = Запрос.Выполнить().Выбрать();
    Пока Выборка.Следующий() Цикл
        Если СтрДлина(Выборка.Штрихкод) = 13 И СтрНайтиПоРегулярномуВыражению(Выборка.Штрихкод, "^[0-9]{13}$").Длина = 13 Тогда
            Сумма = 0;
            Для Номер = 1 По 12 Цикл
                Сумма = Сумма + Число(Сред(Выборка.Штрихкод, Номер, 1)) * ?(Номер % 2 = 0, 3, 1);
            КонецЦикла;
            Если (10 - Сумма % 10) % 10 = Число(Прав(Выборка.Штрихкод, 1)) Тогда
                Возврат Выборка.Штрихкод;
            КонецЕсли;
        КонецЕсли;
    КонецЦикла;
    Блокировка = Новый БлокировкаДанных;
    Блокировка.Добавить("РегистрСведений.ШтрихкодыНоменклатуры");
    Блокировка.Заблокировать();
    Код = РегистрыСведений.ШтрихкодыНоменклатуры.СформироватьШтрихкодEAN13();
    Если Не ЗначениеЗаполнено(Код) Тогда
        ВызватьИсключение "В УТ требуется настроить диапазон внутренних штрихкодов EAN-13.";
    КонецЕсли;
    НоваяЗапись = РегистрыСведений.ШтрихкодыНоменклатуры.СоздатьМенеджерЗаписи();
    НоваяЗапись.Номенклатура = Ссылка;
    НоваяЗапись.Штрихкод = Код;
    НоваяЗапись.Записать(Ложь);
    Возврат Код;
КонецФункции

Функция ЦенаОпт(Ссылка)
    Если ЦенообразованиеВызовСервера.ИспользуетсяЦенообразование25() Тогда
        Регистр = "ЦеныНоменклатуры25";
        Отбор = "ХарактеристикаЦО = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатурыДляЦенообразования.ПустаяСсылка)
            |И СерияЦО = ЗНАЧЕНИЕ(Справочник.СерииНоменклатурыДляЦенообразования.ПустаяСсылка)
            |И УпаковкаЦО = ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)";
    Иначе
        Регистр = "ЦеныНоменклатуры";
        Отбор = "Характеристика = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)";
    КонецЕсли;
    Запрос = Новый Запрос("ВЫБРАТЬ Ц.Цена, Ц.Валюта.Код КАК КодВалюты ИЗ РегистрСведений."
        + Регистр + ".СрезПоследних(&Дата, Номенклатура = &Товар И " + Отбор
        + " И ВидЦены.Наименование = ""Опт"" И НЕ ВидЦены.ПометкаУдаления) КАК Ц
        |ГДЕ Ц.Упаковка = ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)");
    Запрос.УстановитьПараметр("Товар", Ссылка);
    Запрос.УстановитьПараметр("Дата", ТекущаяДатаСеанса());
    Выборка = Запрос.Выполнить().Выбрать();
    Если Не Выборка.Следующий() Тогда
        Возврат 0;
    КонецЕсли;
    Цена = Выборка.Цена;
    Если Выборка.КодВалюты <> "643" Или Выборка.Следующий() Тогда
        ВызватьИсключение "Для изделия требуется одна действующая цена «Опт» в рублях за штуку.";
    КонецЕсли;
    Возврат Цена;
КонецФункции
